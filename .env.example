# ==============================================================================
# InvoiceIQ — Environment Configuration
# ==============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.
#
# Docker Compose reads `.env` automatically from the project directory.
# For `./mvnw spring-boot:run`, export the same variables in your shell first.
#   Windows (PowerShell):  $env:JWT_SECRET_KEY="..."
#   Linux/macOS (bash):    export JWT_SECRET_KEY="..."
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED — Security
# ──────────────────────────────────────────────────────────────────────────────

# HS256 key, base64, >= 256 bits. Generate with:
#   openssl rand -base64 32
JWT_SECRET_KEY=<your-base64-hs256-secret>

# Shared token between Java backend and Python OCR service.
AI_SERVICE_TOKEN=dev-local-token-change-me

# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=invoiceiq
POSTGRES_PASSWORD=invoiceiq_password
POSTGRES_DB=invoiceiq_db

# ──────────────────────────────────────────────────────────────────────────────
# OCR Service
# ──────────────────────────────────────────────────────────────────────────────

# Where the backend reaches the OCR service.
# For local dev:  http://localhost:8000
# For Docker:     http://python-ocr:8000  (set automatically by docker-compose)
APP_OCR_SERVICE_URL=http://localhost:8000
OCR_CONNECT_TIMEOUT=5
OCR_READ_TIMEOUT=120

# ──────────────────────────────────────────────────────────────────────────────
# Document Storage
# ──────────────────────────────────────────────────────────────────────────────

# Options: "local" (default) or "s3"
STORAGE_TYPE=local

# Local filesystem storage directory (used when STORAGE_TYPE=local)
STORAGE_LOCAL_DIR=./data/storage

# S3 / S3-compatible storage (used when STORAGE_TYPE=s3)
# S3_BUCKET=my-invoiceiq-bucket
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Redis (optional — currently unused by business logic)
# ──────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
