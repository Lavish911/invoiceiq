# Local development environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.
#
# Docker Compose reads `.env` automatically from the project directory.
# For `./mvnw spring-boot:run`, export the same variables in your shell first.
#   Windows (PowerShell):  $env:JWT_SECRET_KEY="..."
#   Linux/macOS (bash):    export JWT_SECRET_KEY="..."

# Required. HS256 key, base64, >= 256 bits. Generate with:
#   openssl rand -base64 32
#   (Windows without openssl: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 })))
JWT_SECRET_KEY=<your-base64-hs256-secret>

# Shared token between the Java backend and the Python OCR service.
# Must match on both sides. Any value works locally; use a long random one.
AI_SERVICE_TOKEN=dev-local-token-change-me

# Where the backend reaches the OCR service (host-side URL when running via Maven).
APP_OCR_SERVICE_URL=http://localhost:8000

# Local document storage directory (git-ignored runtime data).
APP_STORAGE_LOCAL_DIR=./data/storage

# Local Postgres (matches docker-compose defaults; change for real environments).
POSTGRES_USER=invoiceiq
POSTGRES_PASSWORD=invoiceiq_password
POSTGRES_DB=invoiceiq_db
