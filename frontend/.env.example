# Public facing API base path (typically just /api which uses the Next.js proxy)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME="InvoiceIQ"

# Server-side proxy destination (Local vs Production backend)
# Local:
# BACKEND_API_URL=http://127.0.0.1:8080
# Production:
# BACKEND_API_URL=https://backend-production-3d1d.up.railway.app
